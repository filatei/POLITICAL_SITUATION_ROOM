# Postgres
DATABASE_URL=postgresql://psr:psr@localhost:5432/psr?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=763064592541-afo8b3po66bmo04q9ecselk9prske4l0.apps.googleusercontent.com

# SMS OTP provider: log | termii | twilio  (log just prints the code to server logs)
SMS_PROVIDER=log
TERMII_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Media storage dir (served from /uploads)
UPLOAD_DIR=./public/uploads

# Same Google client id, exposed to the browser for the Sign-In button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=763064592541-afo8b3po66bmo04q9ecselk9prske4l0.apps.googleusercontent.com
