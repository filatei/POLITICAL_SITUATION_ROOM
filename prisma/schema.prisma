// Political Situation Room — data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ElectionType {
  PRESIDENTIAL
  GOVERNORSHIP
  SENATORIAL
  HOUSE_OF_REPS
  STATE_ASSEMBLY
  LG_CHAIRMANSHIP
}

enum ElectionStatus {
  SETUP
  LIVE
  CLOSED
}

enum Role {
  ADMIN
  COORDINATOR
  ANALYST
  AGENT
}

enum Scope {
  NATIONAL
  STATE
  LGA
  WARD
  PU
}

enum SubmissionType {
  MESSAGE
  SCORE
  INCIDENT
  STATUS
}

enum Channel {
  TEXT
  VOICE
}

enum Confidence {
  DECLARED
  PERCEIVED
  ESTIMATE
}

enum ScoreStatus {
  PENDING
  VERIFIED
  DISPUTED
}

enum MediaKind {
  RESULT_SHEET
  INCIDENT
  VOICE
  OTHER
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AgentStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Election {
  id        String         @id @default(cuid())
  name      String
  type      ElectionType
  date      DateTime
  status    ElectionStatus @default(SETUP)
  createdAt DateTime       @default(now())

  // Geographic scope of the contest. scopeLevel is derived from `type`:
  //   PRESIDENTIAL      -> NATION      (whole country, no refs)
  //   GOVERNORSHIP      -> STATE       (scopeStateId)
  //   STATE_ASSEMBLY    -> STATE       (scopeStateId)   [state-wide monitoring]
  //   LG_CHAIRMANSHIP   -> STATE       (scopeStateId; scopeLgaId optional)
  //   SENATORIAL        -> SENATORIAL  (scopeStateId + scopeConstituencyId)
  //   HOUSE_OF_REPS     -> FEDERAL     (scopeStateId + scopeConstituencyId)
  scopeLevel        String        @default("STATE")
  scopeStateId      String?
  scopeState        State?        @relation(fields: [scopeStateId], references: [id])
  scopeConstituencyId String?
  scopeConstituency Constituency? @relation(fields: [scopeConstituencyId], references: [id])
  scopeLgaId        String?

  parties      Party[]
  candidates   Candidate[]
  agents       Agent[]
  submissions  Submission[]
  instructions Instruction[]
  subscription Subscription?
  tenant       Tenant?
}

model Party {
  id         String      @id @default(cuid())
  electionId String
  election   Election    @relation(fields: [electionId], references: [id])
  code       String
  name       String
  color      String      @default("#444444")
  logoUrl    String?
  candidates Candidate[]

  @@unique([electionId, code])
}

model Candidate {
  id           String        @id @default(cuid())
  electionId   String
  election     Election      @relation(fields: [electionId], references: [id])
  partyId      String
  party        Party         @relation(fields: [partyId], references: [id])
  name         String
  runningMate  String?
  constituency String?
  scores       ScoreRecord[]

  @@index([electionId])
}

model State {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  lgas  Lga[]
  units PollingUnit[]
  agents Agent[]
  constituencies Constituency[]
  elections Election[]
}

model Lga {
  id      String @id @default(cuid())
  stateId String
  state   State  @relation(fields: [stateId], references: [id])
  code    String
  name    String
  wards   Ward[]
  units   PollingUnit[]
  agents  Agent[]
  constituencyLinks ConstituencyLga[]

  @@unique([stateId, code])
}

model Ward {
  id     String @id @default(cuid())
  lgaId  String
  lga    Lga    @relation(fields: [lgaId], references: [id])
  code   String
  name   String
  units  PollingUnit[]
  agents Agent[]

  @@unique([lgaId, code])
}

model PollingUnit {
  id            String  @id @default(cuid())
  wardId        String
  ward          Ward    @relation(fields: [wardId], references: [id])
  lgaId         String
  lga           Lga     @relation(fields: [lgaId], references: [id])
  stateId       String
  state         State   @relation(fields: [stateId], references: [id])
  code          String
  name          String
  registeredVoters Int  @default(0)
  lat           Float?
  lng           Float?
  agents        Agent[]
  submissions   Submission[]

  @@unique([wardId, code])
  @@index([lgaId])
  @@index([stateId])
}

// Server-side backup of each imported harvest file, so the warehouse can be
// rebuilt (State/Lga/Ward/PollingUnit) without re-uploading files from a laptop.
model GeoImport {
  state      String   @id // uppercase state name
  units      Int      @default(0)
  payload    Json // the harvested rows: [{ id, pu, delim, lga, ward }]
  importedAt DateTime @updatedAt
}

// Electoral constituencies that group whole LGAs:
//   SENATORIAL — 3 per state + FCT (109 senators)
//   FEDERAL    — House of Reps federal constituencies (360)
// Membership is LGA-level (senatorial & federal constituencies are composed of
// whole LGAs). An election scoped to a constituency monitors only the polling
// units inside these LGAs, so agents are provisioned to the correct units.
model Constituency {
  id          String            @id @default(cuid())
  type        ConstituencyType
  stateId     String
  state       State             @relation(fields: [stateId], references: [id])
  code        String? // INEC delimitation code, e.g. SD/001/AB, FC/002/AB, SC/003/AB
  name        String
  composition Json? // raw member names: LGAs (SENATORIAL/FEDERAL) or RAs/wards (STATE)
  collation   String? // INEC collation-centre name, when provided
  lgaLinks    ConstituencyLga[]
  elections   Election[]

  @@unique([stateId, type, name])
  @@index([stateId, type])
}

model ConstituencyLga {
  id             String       @id @default(cuid())
  constituencyId String
  constituency   Constituency @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  lgaId          String
  lga            Lga          @relation(fields: [lgaId], references: [id], onDelete: Cascade)

  @@unique([constituencyId, lgaId])
  @@index([lgaId])
}

enum ConstituencyType {
  SENATORIAL
  FEDERAL
  STATE
}

// Platform-wide registry of party details harvested from INEC (factual public
// registration data). Separate from per-election Party rows. Officials/contacts
// change over time, so every change is logged in PartyRegistryChange.
model PartyRegistry {
  code               String   @id // acronym, e.g. APC
  name               String
  slug               String? // INEC url slug
  chairman           String?
  secretary          String?
  treasurer          String?
  financialSecretary String?
  legalAdviser       String?
  address            String?
  email              String?
  phone              String?
  logoUrl            String?
  source             String? // INEC page url
  checkedAt          DateTime @default(now()) // last harvested/verified
  updatedAt          DateTime @updatedAt // last time any field changed
  createdAt          DateTime @default(now())
  changes            PartyRegistryChange[]
}

model PartyRegistryChange {
  id        String        @id @default(cuid())
  code      String
  party     PartyRegistry @relation(fields: [code], references: [code], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime      @default(now())

  @@index([code, changedAt])
}

// Server-side backup of an imported constituency file, keyed by state+type, so
// the constituency map can be rebuilt without re-uploading.
model ConstituencyImport {
  key        String   @id // e.g. "ONDO:SENATORIAL"
  state      String
  type       String
  count      Int      @default(0)
  payload    Json // [{ name, code?, lgas: [lgaName] }]
  importedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role     @default(ANALYST)
  passwordHash String?
  googleSub    String?  @unique
  // Tenant binding: the election this staff member may administer. NULL = a
  // platform super-admin / global staff (not pinned to a single tenant).
  electionId   String?
  // Bumped to invalidate all existing JWTs for this user (revocation).
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  submissions  Submission[]
  instructions Instruction[]
}

model Agent {
  id            String      @id @default(cuid())
  electionId    String
  election      Election    @relation(fields: [electionId], references: [id])
  name          String
  phone         String?
  email         String?     @unique  // pre-profiled Google email for agent sign-in
  role          Role        @default(AGENT)
  scope         Scope       @default(PU)
  pollingUnitId String?
  pollingUnit   PollingUnit? @relation(fields: [pollingUnitId], references: [id])
  wardId        String?
  ward          Ward?       @relation(fields: [wardId], references: [id])
  lgaId         String?
  lga           Lga?        @relation(fields: [lgaId], references: [id])
  stateId       String?
  state         State?      @relation(fields: [stateId], references: [id])
  inviteCode    String      @unique
  inviteUsedAt  DateTime?
  pinHash       String?
  status        AgentStatus @default(INVITED)
  // Bumped on reset/suspend to invalidate the agent's existing JWT (revocation).
  tokenVersion  Int         @default(0)
  lastSeenAt    DateTime?
  createdAt     DateTime    @default(now())
  submissions   Submission[]
  receipts      InstructionReceipt[]

  @@index([electionId])
  @@index([electionId, pollingUnitId])
}

model Submission {
  id            String         @id @default(cuid())
  clientUid     String         @unique
  electionId    String
  election      Election       @relation(fields: [electionId], references: [id])
  type          SubmissionType
  channel       Channel        @default(TEXT)
  text          String?
  severity      Severity?

  agentId       String?
  agent         Agent?         @relation(fields: [agentId], references: [id])
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])

  pollingUnitId String?
  pollingUnit   PollingUnit?   @relation(fields: [pollingUnitId], references: [id])

  // result-sheet level stats (for SCORE submissions)
  accreditedVoters Int?
  totalVotesCast   Int?
  rejectedBallots  Int?
  confidence       Confidence?
  sheetSigned      Boolean?
  scoreStatus      ScoreStatus  @default(PENDING)

  lat           Float?
  lng           Float?
  capturedAt    DateTime
  receivedAt    DateTime       @default(now())

  scores        ScoreRecord[]
  media         Media[]

  @@index([electionId, receivedAt])
  @@index([type])
}

model ScoreRecord {
  id           String      @id @default(cuid())
  submissionId String
  submission   Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    Candidate   @relation(fields: [candidateId], references: [id])
  votes        Int

  @@index([candidateId])
  @@index([submissionId])
}

model Media {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  url          String
  thumbUrl     String?
  mime         String
  size         Int
  kind         MediaKind  @default(OTHER)
  sha256       String?
  sheetSigned  Boolean?
  durationSec  Int?
  width        Int?
  height       Int?
  createdAt    DateTime   @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorType String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  at        DateTime @default(now())

  @@index([entity, entityId])
}

// A tenant is one white-labelled situation room for one election, addressed at
// /{slug} (e.g. ondogov2027, ondosouthsenate2027).
model Tenant {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  electionId   String   @unique
  election     Election @relation(fields: [electionId], references: [id])
  contactEmail String?
  contactPhone String?
  adminEmails  String[] @default([])
  adminPhones  String[] @default([]) // extra phone numbers allowed to admin-login
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

// White-label branding (single row per deployment/tenant).
model Branding {
  id         String   @id @default(cuid())
  // Per-tenant branding: one row per election. NULL = the platform default row.
  electionId String?  @unique
  name       String   @default("Situation Room")
  tagline    String   @default("Real-time election monitoring")
  accent     String   @default("#5b8cff")
  logoUrl    String?
  updatedAt  DateTime @updatedAt
}

enum PaymentProvider {
  PAYSTACK
  SQUAD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// One subscription per election: 10 free seats to trial, plus purchased seats.
// A "seat" = one agent code. Available = freeSeats + paidSeats - codes created.
model Subscription {
  id         String   @id @default(cuid())
  electionId String   @unique
  election   Election @relation(fields: [electionId], references: [id])
  freeSeats  Int      @default(10)
  paidSeats  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payment {
  id         String          @id @default(cuid())
  reference  String          @unique
  provider   PaymentProvider
  electionId String?
  seats      Int
  amount     Int             // in kobo
  email      String?
  status     PaymentStatus   @default(PENDING)
  meta       Json?
  createdAt  DateTime        @default(now())

  @@index([status])
}

// AI knowledge base: chunks of the Electoral Act, the app guide, structure facts,
// etc. Retrieved by keyword and fed to the assistant as grounding context.
model KnowledgeChunk {
  id        String   @id @default(cuid())
  source    String   // "electoral-act-2022" | "app-guide" | "electoral-structure"
  section   String?  // "Section 51", "Part V", "3.2"
  title     String
  content   String
  ord       Int      @default(0)
  createdAt DateTime @default(now())

  @@index([source])
}

enum InstructionStatus {
  SENT
  DELIVERED
  ACK
  READ
}

enum InstructionTarget {
  AGENT
  UNIT
  WARD
  LGA
  ALL
}

model Instruction {
  id         String            @id @default(cuid())
  electionId String
  election   Election          @relation(fields: [electionId], references: [id])
  fromUserId String?
  fromUser   User?             @relation(fields: [fromUserId], references: [id])
  target     InstructionTarget @default(AGENT)
  targetId   String?           // agentId / unitId / wardId / lgaId (null for ALL)
  title      String?
  body       String
  severity   Severity          @default(INFO)
  createdAt  DateTime          @default(now())
  receipts   InstructionReceipt[]

  @@index([electionId, createdAt])
}

model InstructionReceipt {
  id            String            @id @default(cuid())
  instructionId String
  instruction   Instruction       @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  agentId       String
  agent         Agent             @relation(fields: [agentId], references: [id])
  status        InstructionStatus @default(SENT)
  deliveredAt   DateTime?
  ackedAt       DateTime?
  readAt        DateTime?

  @@unique([instructionId, agentId])
  @@index([agentId, status])
}

// Short-lived one-time codes for WhatsApp/SMS admin login (hashed, attempt-capped).
model LoginOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}
